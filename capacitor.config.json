{
  "appId": "com.nailflow.salonmanager",
  "appName": "NailFlow",
  "webDir": "www",
  "server": {
    "url": "https://american-nails-and-spa.com/app/",
    "allowNavigation": ["american-nails-and-spa.com", "*.american-nails-and-spa.com"],
    "errorPath": "offline.html"
  },
  "ios": { "contentInset": "never", "limitsNavigationsToAppBoundDomains": false, "backgroundColor": "#0F1420" },
  "android": { "backgroundColor": "#0F1420", "allowMixedContent": false },
  "plugins": {
    "SplashScreen": { "launchShowDuration": 1200, "launchAutoHide": true, "backgroundColor": "#0F1420", "showSpinner": false },
    "FirebaseMessaging": { "presentationOptions": ["badge", "sound", "alert"] }
  }
}
