diff -ruN int653/inc/calls-live.php int654/inc/calls-live.php
--- int653/inc/calls-live.php	1969-12-31 18:00:00.000000000 -0600
+++ int654/inc/calls-live.php	2026-11-05 21:44:42.435736822 -0600
@@ -0,0 +1,156 @@
+<?php
+/* (2.99.654 - anh Logan 05/11 21:31 "Telnyx và book hẹn ngay lập tức trong lúc đang nói chuyện")
+   LIVE BOOKING on a call the OWNER answers (Telnyx): the call's words come in while they talk (<Start><Transcription> Deepgram nova-3, both legs),
+   and as soon as service + day + time are said and the salon said OK, the appointment is booked (the SAME cl_decide as after the call).
+   The caller adds a person / a service / changes the time -> the booking made on the call is replaced (nothing was texted yet).
+   The customer's YOU'RE BOOKED text goes only AFTER the call: the recording (both channels) is read as before (cl_job) and
+     - says the same            -> the booking made on the call is kept, the text goes;
+     - says something different -> the booking is replaced by the recording's one (texted once);
+     - cannot be read / no OK   -> the booking made on the call stays, NO text, the owner is asked to check it (📞 Check booking).
+   Off (default): nothing changes. Setting tx_live = '1' (AN HQ). Only a call the owner's iPhone answered (screen 'human'); the AI part never. */
+declare(strict_types=1);
+
+const TXL_ENGINE = 'Deepgram';
+const TXL_MODEL = 'deepgram/nova-3';
+const TXL_GAP = 3;      // seconds between two readings of the same call (the words keep coming)
+const TXL_MAX_N = 60;   // readings per call at most (cost guard)
+
+function txl_on(): bool { return setting('tx_live') === '1'; }
+/** The TeXML before the iPhone's <Dial>: the words of both legs to ?a=tr. */
+function txl_start(string $q): string {
+    return '<Start><Transcription transcriptionEngine="' . TXL_ENGINE . '" model="' . TXL_MODEL . '" transcriptionTracks="both" language="en" interimResults="false"'
+        . ' transcriptionCallback="' . cl_x(tx_url('tr', $q)) . '" transcriptionCallbackMethod="POST"/></Start>';
+}
+function txl_file(string $sid, string $ext): string { return cl_dir() . '/txl-' . md5($sid) . '.' . $ext; }
+/** The leg of a transcript: 'c' the caller (inbound = the leg that asked for it), 's' the salon (outbound), '' not given. */
+function txl_track(array $in): string {
+    $t = strtolower(tx_f($in, ['Track', 'track', 'TranscriptionTrack', 'transcription_track', 'Leg', 'leg']));
+    if ($t === '' && isset($in['transcription_data']) && is_array($in['transcription_data'])) $t = strtolower((string)($in['transcription_data']['transcription_track'] ?? ''));
+    return str_starts_with($t, 'out') ? 's' : (str_starts_with($t, 'in') ? 'c' : '');
+}
+/** ?a=tr - one piece of the call's words (final pieces only). */
+function txl_in(array $in): void {
+    $sid = mb_substr((string)($_GET['sid'] ?? tx_f($in, ['CallSid', 'call_sid'])), 0, 64); if ($sid === '') return;
+    $d = isset($in['transcription_data']) && is_array($in['transcription_data']) ? $in['transcription_data'] : [];
+    $txt = trim(tx_f($in, ['Transcript', 'transcript', 'TranscriptionText'])); if ($txt === '') $txt = trim((string)($d['transcript'] ?? ''));
+    $fin = strtolower(tx_f($in, ['IsFinal', 'is_final'])); if ($fin === '' && isset($d['is_final'])) $fin = $d['is_final'] ? 'true' : 'false';
+    if (($in['IsFinal'] ?? null) === false || ($in['is_final'] ?? null) === false) $fin = 'false'; /* (review) a JSON false is '' for tx_f */
+    $k = txl_track($in);
+    tx_log('tr', ['keys' => array_keys($in), 'final' => $fin, 'track' => $k, 'len' => mb_strlen($txt)]); /* the first ones: what Telnyx really sends (no words in the log) */
+    if ($txt === '' || ($fin !== '' && !in_array($fin, ['true', '1'], true))) return;
+    $r = q('SELECT kind, status FROM calls WHERE call_sid = ?', [$sid])->fetch(); if (!$r || (string)$r['kind'] !== 'call' || (string)$r['status'] !== 'ring') return; /* (review) the AI part / an ended call: nothing kept */
+    if (!is_dir(cl_dir())) @mkdir(cl_dir(), 0700, true);
+    @file_put_contents(txl_file($sid, 'jsonl'), json_encode(['t' => time(), 'k' => $k, 'x' => mb_substr($txt, 0, 1000)], JSON_UNESCAPED_UNICODE) . "\n", FILE_APPEND | LOCK_EX);
+    try { txl_try($sid); } catch (Throwable $e) { error_log('654 live ' . get_class($e) . ': ' . mb_substr($e->getMessage(), 0, 200)); }
+}
+function txl_lines(string $sid): array {
+    $f = txl_file($sid, 'jsonl'); if (!is_file($f)) return [];
+    $o = []; foreach (file($f, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) ?: [] as $l) { $j = json_decode($l, true); if (is_array($j) && trim((string)($j['x'] ?? '')) !== '') $o[] = $j; }
+    return $o;
+}
+/** [caller's words, salon's words]. No leg given by Telnyx: both get the whole talk (the recording after the call checks who said OK). */
+function txl_texts(array $L): array {
+    $c = []; $s = []; $all = [];
+    foreach ($L as $l) { $x = trim((string)$l['x']); $all[] = $x; if (($l['k'] ?? '') === 'c') $c[] = $x; elseif (($l['k'] ?? '') === 's') $s[] = $x; }
+    if (count($c) + count($s) < count($all)) return [implode("\n", $all), implode("\n", $all)];
+    return [implode("\n", $c), implode("\n", $s)];
+}
+function txl_state(string $sid): array { $j = json_decode((string)@file_get_contents(txl_file($sid, 'json')), true); return is_array($j) ? $j : []; }
+function txl_save(string $sid, array $st): void { @file_put_contents(txl_file($sid, 'json'), json_encode($st), LOCK_EX); }
+/** What a booking is (who / services / day / time / tech): the same = the same booking. The name is left out (spelled differently). */
+function txl_sig(array $j): string {
+    $ids = fn($a) => implode(',', (function ($x) { $x = array_values(array_unique(array_filter(array_map('intval', (array)$x)))); sort($x); return $x; })($a));
+    $party = array_values(array_filter((array)($j['party'] ?? []), 'is_array')); $sv = (array)($j['service_ids'] ?? []); $tid = (int)($j['tech_id'] ?? 0);
+    $n = max(1, (int)($j['people'] ?? 1), count($party));
+    if ($n === 1 && $party) { $sv = array_merge($sv, (array)($party[0]['service_ids'] ?? [])); if (!$tid) $tid = (int)($party[0]['tech_id'] ?? 0); $party = []; } /* (review #7) one person: 'party' [] or [1 entry] = the same */
+    $p = []; foreach ($party as $e) $p[] = $ids($e['service_ids'] ?? []) . '/' . (int)($e['tech_id'] ?? 0); sort($p);
+    $ph = norm_phone((string)($j['customer_phone'] ?? ''));
+    return md5(json_encode([strtolower((string)($j['intent'] ?? '')), (string)($j['date'] ?? ''), (string)($j['time'] ?? ''), $n, $ids($sv), $tid, !$tid && !empty($j['tech_last']), $p,
+        !empty($j['same_services']), (string)($j['mani_type'] ?? ''), (string)($j['pedi_type'] ?? ''), strlen($ph) === 12 ? $ph : '']));
+}
+/** (review #2) The recording really has the salon's OK (the same check as cl_decide0) and the AI is sure enough. */
+function txl_ok(array $c, array $j): bool {
+    $cf = $j['confidence'] ?? null; if ((is_int($cf) || is_float($cf)) && (float)$cf < CL_MIN_CONF) return false;
+    if ((string)$c['kind'] === 'vm') return true;
+    $q = cl_norm((string)($j['salon_quote'] ?? ''));
+    return !empty($j['salon_agreed']) && $q !== '' && str_contains(' ' . cl_norm((string)$c['text_s']) . ' ', ' ' . $q . ' ');
+}
+/** The call's lock (a reading on the call and the reading after it never at the same time). */
+function txl_lock(string $sid, bool $wait) { $fh = @fopen(txl_file($sid, 'lock'), 'c'); if (!$fh) return null; if (!flock($fh, $wait ? LOCK_EX : LOCK_EX | LOCK_NB)) { fclose($fh); return null; } return $fh; }
+function txl_unlock($fh): void { if ($fh) { flock($fh, LOCK_UN); fclose($fh); } }
+/** The appointments of a booking made on the call that are still booked. */
+function txl_rows(array $ids): array { $o = []; foreach (array_unique(array_map('intval', $ids)) as $id) { $a = q('SELECT * FROM appointments WHERE id = ?', [$id])->fetch(); if ($a && (string)$a['status'] === 'booked') $o[] = $a; } return $o; }
+function txl_ids_of(int $first): array { $a = $first ? q('SELECT * FROM appointments WHERE id = ?', [$first])->fetch() : null; if (!$a) return []; return array_map(fn($m) => (int)$m['id'], group_members($a)); }
+/** Taken off quietly (made on the call, never texted): the place is free again for the new one. */
+function txl_drop(array $rows, string $why): void { foreach ($rows as $a) { q("UPDATE appointments SET status = 'cancelled', confirm_state = 'no' WHERE id = ? AND status = 'booked'", [$a['id']]); appt_log($a, 'cancelled', $why); } }
+function txl_back(array $rows): void { foreach ($rows as $a) { q("UPDATE appointments SET status = 'booked', confirm_state = '' WHERE id = ? AND status = 'cancelled'", [$a['id']]); /* (review #5) */ appt_log($a, 'changed', 'Kept – the booking made on the call'); } }
+
+/** One reading while they talk: booked as soon as everything is said and the salon said OK; changed when the caller changes it. */
+function txl_try(string $sid): void {
+    if (!txl_on()) return;
+    $lk = txl_lock($sid, false); if (!$lk) return; // a reading is running; the next words read again
+    try {
+        $c = q('SELECT * FROM calls WHERE call_sid = ?', [$sid])->fetch();
+        if (!$c || (string)$c['kind'] !== 'call' || (string)$c['status'] !== 'ring' || !in_array((string)$c['screen'], ['human', 'person'], true) /* the iPhone answered by a person (AMD) / the screened owner (2.99.591) */ || is_demo_site()) return; // only while the owner is on the call
+        $L = txl_lines($sid); $st = txl_state($sid);
+        if (count($L) <= (int)($st['n'] ?? 0) || (int)($st['reads'] ?? 0) >= TXL_MAX_N || time() - (int)($st['at'] ?? 0) < TXL_GAP) return;
+        [$tc, $ts] = txl_texts($L); $st['n'] = count($L); $st['at'] = time();
+        if (!cl_ivr_has_when($tc . ' ' . $ts) || !cl_ai_ready()) { txl_save($sid, $st); return; }
+        $cc = $c; $cc['text_c'] = $tc; $cc['text_s'] = $ts;
+        if (empty($st['counted'])) { if (!cl_count()) { $st['reads'] = TXL_MAX_N; txl_save($sid, $st); return; } $st['counted'] = 1; } /* (review) the day's AI cap: one per call */
+        $st['reads'] = (int)($st['reads'] ?? 0) + 1; txl_save($sid, $st);
+        $GLOBALS['actor'] = ['call', '📞 Call assistant'];
+        $ai = cl_weekday_fix($cc, cl_ai_after($cc, cl_ai($cc)));
+        if (strtolower(trim((string)($ai['intent'] ?? ''))) !== 'book') return;
+        $sig = txl_sig($ai); if ($sig === (string)($st['sig'] ?? '')) return;
+        $old = txl_rows((array)($st['ids'] ?? []));
+        if ($old) txl_drop($old, 'Changed on the call – booked again with what the caller said');
+        $GLOBALS['cl_live'] = 1; $GLOBALS['cl_live_ask'] = []; q('UPDATE calls SET appt_id = 0 WHERE id = ?', [$c['id']]);
+        try { $r = cl_decide($cc, $ai); }
+        catch (Throwable $e) { if ($old) { txl_back($old); q('UPDATE calls SET appt_id = ? WHERE id = ?', [(int)$old[0]['id'], $c['id']]); } throw $e; } /* (review #9) */
+        finally { $GLOBALS['cl_live'] = 0; }
+        $first = (int)q('SELECT appt_id FROM calls WHERE id = ?', [$c['id']])->fetchColumn();
+        if ($r === 'booked' && $first) { $st['ids'] = txl_ids_of($first); $st['sig'] = $sig; $st['ask'] = (array)($GLOBALS['cl_live_ask'] ?? []); txl_save($sid, $st); return; }
+        if ($old) { txl_back($old); q('UPDATE calls SET appt_id = ? WHERE id = ?', [(int)$old[0]['id'], $c['id']]); } // not bookable yet (e.g. the new time is taken): the earlier one stays
+    } finally { txl_unlock($lk); }
+}
+
+/** After the call (cl_job -> cl_decide): the booking made on the call vs what the recording says. null = nothing was booked on the call. */
+function txl_after(array $c, array $j): ?string {
+    $sid = (string)$c['call_sid']; if ($sid === '' || !is_file(txl_file($sid, 'json'))) return null;
+    $lk = txl_lock($sid, true);
+    try {
+        $st = txl_state($sid); $rows = txl_rows((array)($st['ids'] ?? []));
+        if (!$rows) return null;
+        if (!empty($st['done'])) return 'booked'; /* (review) read again (a retry): already decided - never a 2nd booking */
+        $st['done'] = 1; txl_save($sid, $st); @unlink(txl_file($sid, 'jsonl')); /* (review #8) the words are not kept */
+        $intent = strtolower(trim((string)($j['intent'] ?? '')));
+        if ($intent === 'book' && txl_sig($j) === (string)($st['sig'] ?? '') && txl_ok($c, $j)) return txl_keep($c, $rows, true, (array)($st['ask'] ?? []));
+        if ($intent === 'book' && txl_sig($j) !== (string)($st['sig'] ?? '')) {
+            txl_drop($rows, 'Replaced by the recording of the call');
+            $GLOBALS['cl_txl_try'] = 1;
+            try { $r = cl_decide0($c, $j); } catch (Throwable $e) { txl_back($rows); throw $e; } finally { $GLOBALS['cl_txl_try'] = 0; }
+            if ($r === 'booked') return $r;
+            txl_back($rows);
+        }
+        return txl_keep($c, $rows, false);
+    } finally { txl_unlock($lk); }
+}
+/** The booking made on the call is the one: texted (the recording says the same) or kept for the owner to check (no text). */
+function txl_keep(array $c, array $rows, bool $text, array $ask = [], string $why = ''): string {
+    $a = $rows[0]; $line = cl_line($a) . (count($rows) > 1 ? ' · ' . count($rows) . ' people' : '');
+    q('UPDATE calls SET appt_id = ?, conf_at = ?, conf_done = ? WHERE id = ?', [(int)$a['id'], $text ? now_str() : '', $text ? 0 : 1, $c['id']]);
+    foreach ($rows as $r) notify_staff((int)$r['staff_id'], 'new', 'New: ' . appt_line($r), (int)$r['id']); /* (review #6) the techs: once, after the call */
+    $GLOBALS['cl_ask'] = $text ? $ask : []; /* (review #3) the type question only with the text, never a leftover */
+    cl_end($c, 'booked', $text ? '' : 'Booked on the call – ' . ($why !== '' ? rtrim($why, '.') . ' – ' : 'the recording did not confirm it – ') . 'check it (no text sent).', $line, false);
+    if ($text) cl_confirm_due();
+    else cl_push((int)$c['id'], '📞 Check booking', $line . ' · booked on the call, not texted – check it');
+    return 'booked';
+}
+/** (review #4) The call ends in review / callback before the recording could decide (long call, no key, the AI cap, errors…): a booking made on it is kept, no text, the owner checks it. */
+function txl_pending(array $c, string $why): ?string {
+    $sid = (string)($c['call_sid'] ?? ''); if ($sid === '' || !is_file(txl_file($sid, 'json'))) return null;
+    $st = txl_state($sid); if (!empty($st['done'])) return null; $rows = txl_rows((array)($st['ids'] ?? [])); if (!$rows) return null;
+    $st['done'] = 1; txl_save($sid, $st); @unlink(txl_file($sid, 'jsonl'));
+    return txl_keep($c, $rows, false, [], $why);
+}
