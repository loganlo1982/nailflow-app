@@ -0,0 +1,47 @@
+/* (2.99.660 keys) AN HQ → a salon card → 🔑 Keys: the ONLY place where a salon's secret keys are set (owner decision 06/11, same for every salon):
+   📲 the SMS Server key + salon id, the Android SMS Gateway login (username / password / signing key), 💳 PayPal (Client ID / Secret / Live or Sandbox).
+   Saved on the server encrypted with THAT salon's key; never shown again – a page only sees "saved ✓". Opened from the HQ salon page row "Keys nhắn tin & PayPal" (2.99.660 HQ UI). (2.99.660 push) + 🔔 Firebase (push) slot 1 / 2. */
+'use strict';
+window.HqKeys = (function () {
+  const H = () => window.HQ;
+  const e = (s) => H().esc(s);
+  const ok = (on) => on ? '<b class="hq-tag ok">saved ✓</b>' : '<span class="hq-tag warn">not set</span>';
+  const pw = (id, label, on) => `<label class="hq-lbl" for="${id}">${label} ${ok(on)}</label><input class="hq-in" id="${id}" type="password" autocomplete="new-password" autocapitalize="off" spellcheck="false" placeholder="${on ? 'type only to replace' : ''}">`;
+  async function open(s) {
+    const { api, openSheet, toast, busy, $ } = H();
+    let T, P, F; try { [T, P, F] = await Promise.all([api('texting&id=' + encodeURIComponent(s.id)), api('paypal&id=' + encodeURIComponent(s.id)), api('push_keys&id=' + encodeURIComponent(s.id))]); } catch (x) { return toast(x.message, true); } /* (2.99.660 push) + Firebase */
+    const draw = () => { const K = T.keys || {};
+      openSheet(`<h2>🔑 Keys – ${e(s.name || s.id)}</h2>
+        <p class="hq-muted">Set only here. Kept encrypted with this salon's own key, never shown again. The salon's Settings shows only a status line.</p>
+        <h3 style="margin:12px 0 6px">🖥 SMS Server ${K.wsOn ? '<small class="hq-tag ok">in use</small>' : ''}</h3>
+        <label class="hq-lbl" for="kWsId">Salon id</label><input class="hq-in" id="kWsId" autocapitalize="off" spellcheck="false" maxlength="32" value="${e(K.wsId || '')}" placeholder="an">
+        ${pw('kWsKey', 'Key (nfsms salon-key &lt;id&gt;)', K.wsKey)}
+        <h3 style="margin:14px 0 6px">📲 Android – SMS Gateway ${K.shared ? '<small class="hq-muted">(uses another salon\'s Android)</small>' : ''}</h3>
+        ${pw('kAdUser', 'Username', K.adUser)}${pw('kAdPass', 'Password', K.adPass)}${pw('kAdSign', 'Signing key', K.adSign)}
+        <div class="hq-acts"><button class="hq-btn good" id="kTxSave">Save texting keys</button>${K.adUser ? '<button class="hq-btn sm ghost" type="button" id="kAdClr">Remove Android login</button>' : ''}${K.wsKey ? '<button class="hq-btn sm ghost" type="button" id="kWsClr">Remove SMS Server key</button>' : ''}</div>
+        <h3 style="margin:16px 0 6px">💳 PayPal ${P.ready ? '<small class="hq-tag ok">connected</small>' : '<small class="hq-tag warn">not set up</small>'}</h3>
+        <label class="hq-lbl" for="kPpMode">Mode</label><select class="hq-in" id="kPpMode"><option value="live"${P.mode === 'live' ? ' selected' : ''}>Live (real payments)</option><option value="sandbox"${P.mode === 'sandbox' ? ' selected' : ''}>Sandbox (test only)</option></select>
+        <label class="hq-lbl" for="kPpCid">Client ID ${P.clientSet ? '<b class="hq-tag ok">saved ✓ …' + e(P.clientEnd) + '</b>' : '<span class="hq-tag warn">not set</span>'}</label><input class="hq-in" id="kPpCid" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="${P.clientSet ? 'type only to replace' : ''}">
+        ${pw('kPpSec', 'Secret', P.secretSet)}
+        <p class="hq-muted small">Group deposits ${P.depOn ? 'ON' : 'off'} · online gift cards ${P.giftOnline ? 'ON' : 'off'} (the salon turns them on in its Settings).</p>
+        <div class="hq-acts"><button class="hq-btn good" id="kPpSave">Save PayPal</button>${P.clientSet || P.secretSet ? '<button class="hq-btn sm ghost" type="button" id="kPpClr">Remove PayPal keys</button>' : ''}</div>
+        <h3 style="margin:16px 0 6px">🔔 Firebase (push) – NailFlow app</h3>${/* (2.99.660 push) the service-account .json of slot 1 (old project) / slot 2 (new app, an-salon-push); the salon no longer uploads it */ ''}
+        <p class="hq-muted small">Firebase → Project settings → Service accounts → Generate new private key → choose the .json file. Empty slot = the NailFlow server file is used.</p>
+        ${[['1', 'Slot 1 (old app project)'], ['2', 'Slot 2 (new app · an-salon-push)']].map(([n, t]) => { const x = (F && F['slot' + n]) || {}; return `<label class="hq-lbl" for="kFb${n}">${t} ${ok(x.saved)}${x.saved && x.project ? ' <small class="hq-muted">' + e(x.project) + '</small>' : ''}</label><input class="hq-in" id="kFb${n}" type="file" accept=".json,application/json">${x.saved ? `<button class="hq-btn sm ghost" type="button" id="kFbClr${n}">Remove slot ${n} key</button>` : ''}`; }).join('')}
+        <div class="hq-acts"><button class="hq-btn good" id="kFbSave">Save Firebase keys</button><button class="hq-btn ghost" type="button" data-close>Close</button></div>`);
+      const tx = async (btn, set, say) => { busy(btn, true); try { const r = await api('texting_keys', { id: s.id, set }); T.keys = r.keys; toast(r.changed ? say : 'Nothing changed'); draw(); } catch (y) { toast(y.message, true); busy(btn, false); } };
