@@ -0,0 +1,65 @@
+<?php
+/* (2.99.660 card) AN HQ is the ONLY place where a salon's card processors are set up (owner decision 06/11): Payroc (Terminal ID, device serial number,
+   API key, host, "Card on Payroc") and Dejavoo P5 (TPN, Register ID, Auth Key, "Card on the P5"). Same code for every salon, American Nails too.
+   The API key / Register ID / Auth Key are ENCRYPTED with THAT salon's own key (hq_enc_for = the salon's own ad_enc), so its runtime pr_creds() / dv_creds()
+   decrypt them by themselves. A secret is never sent back (only "saved ✓"), never logged (the audit / HQ log name WHAT changed, never the value).
+   The checks are the same as the salon's old pr_set_creds() / dv_set_creds() (inc/payroc.php, inc/dejavoo.php): everything checked BEFORE anything is saved. */
+declare(strict_types=1);
+require_once __DIR__ . '/hq-keys.php'; /* (2.99.660) the ONE per-salon helper: hq_salon_key / hq_enc_for / hq_dec_for live only in inc/hq-keys.php */
+
+/** What HQ may show of a salon's card processors: the non-secret codes + whether each secret is saved (never a value, never a box). */
+function hq_cards_info(array $c, array $s): array {
+    $prKey = (string)($s['pr_key'] ?? '') !== ''; $prTid = trim((string)($s['pr_tid'] ?? '')); $prSn = trim((string)($s['pr_sn'] ?? ''));
+    $dvTpn = trim((string)($s['dv_tpn'] ?? '')); $dvReg = (string)($s['dv_reg'] ?? '') !== ''; $dvAuth = (string)($s['dv_auth'] ?? '') !== '';
+    return ['pr' => ['tid' => $prTid, 'sn' => $prSn, 'keySet' => $prKey, 'host' => (string)($s['pr_host'] ?? '') === 'std' ? 'std' : 'uat', 'on' => (string)($s['pr_on'] ?? '') === '1',
+                     'ready' => $prTid !== '' && $prKey, 'dev' => $prTid !== '' && $prKey && $prSn !== ''],
+            'dv' => ['tpn' => $dvTpn, 'regSet' => $dvReg, 'authSet' => $dvAuth, 'env' => (string)($s['dv_env'] ?? '') === 'live' ? 'live' : 'uat', 'on' => (string)($s['dv_on'] ?? '') === '1',
+                     'ready' => ($dvTpn !== '' || $dvReg) && $dvAuth]];
+}
+/** HQ → 💳 Card keys of salon $id. GET ($set null): hq_cards_info only. set { pr: {tid, sn, key, host, on, clear}, dv: {tpn, reg, auth, on, clear} }:
+    an empty / missing field keeps what is saved; clear = remove the codes (and turn it off). All checked first, then saved. */
+function hq_card_keys(string $id, ?array $set = null): array {
+    $sl = hq_salon($id); $c = hq_cfg($sl['root']); if (!$c) throw new RuntimeException('No config for this salon.'); $p = hq_pdo($c); $s = hq_set($p, $c);
+    if ($set !== null) {
+        $pr = is_array($set['pr'] ?? null) ? $set['pr'] : null; $dv = is_array($set['dv'] ?? null) ? $set['dv'] : null; $w = []; $chg = [];
+        if ($pr !== null) {
+            if (!empty($pr['clear'])) { foreach (['pr_tid', 'pr_sn', 'pr_key', 'pr_tok'] as $k) $w[$k] = ''; $w['pr_on'] = '0'; $chg[] = 'Payroc codes removed (Card on Payroc off)'; }
+            else {
+                $tid = trim((string)($pr['tid'] ?? '')); $sn = trim((string)($pr['sn'] ?? '')); $key = trim((string)($pr['key'] ?? '')); $host = trim((string)($pr['host'] ?? ''));
+                if ($tid !== '' && !preg_match('/^[A-Za-z0-9]{4,50}$/', $tid)) throw new RuntimeException('Payroc Terminal ID: 4–50 letters / digits.');
+                if ($sn !== '' && !preg_match('/^[A-Za-z0-9_.\-]{1,64}$/', $sn)) throw new RuntimeException('Payroc device serial number: letters / digits only.');
+                if ($key !== '' && (strlen($key) < 16 || strlen($key) > 512 || preg_match('/\s/', $key))) throw new RuntimeException('Payroc API key: check it (no spaces).');
+                if ($host !== '' && $host !== 'uat' && $host !== 'std') throw new RuntimeException('Payroc host: uat or std.');
+                if ($tid !== '' && $tid !== trim((string)($s['pr_tid'] ?? ''))) { $w['pr_tid'] = $tid; $chg[] = 'Payroc Terminal ID'; }
+                if ($sn !== '' && $sn !== trim((string)($s['pr_sn'] ?? ''))) { $w['pr_sn'] = $sn; $chg[] = 'Payroc device'; }
+                if ($key !== '' && hq_dec_for($c, (string)($s['pr_key'] ?? '')) !== $key) { $w['pr_key'] = hq_enc_for($c, $key); $w['pr_tok'] = ''; $chg[] = 'Payroc API key'; }
+                if ($host !== '' && $host !== ((string)($s['pr_host'] ?? '') === 'std' ? 'std' : 'uat')) { $w['pr_host'] = $host; $w['pr_tok'] = ''; $chg[] = 'Payroc host ' . $host; }
+                if (array_key_exists('on', $pr)) { $on = !empty($pr['on']);
+                    $okDev = ($w['pr_tid'] ?? trim((string)($s['pr_tid'] ?? ''))) !== '' && ($w['pr_sn'] ?? trim((string)($s['pr_sn'] ?? ''))) !== '' && ($w['pr_key'] ?? (string)($s['pr_key'] ?? '')) !== '';
+                    if ($on && !$okDev) throw new RuntimeException('Payroc: type the Terminal ID, the device serial number and the API key first.');
+                    if ($on !== ((string)($s['pr_on'] ?? '') === '1')) { $w['pr_on'] = $on ? '1' : '0'; $chg[] = 'Card on Payroc ' . ($on ? 'on' : 'off'); } }
+            }
+        }
+        if ($dv !== null) {
+            if (!empty($dv['clear'])) { foreach (['dv_tpn', 'dv_reg', 'dv_auth'] as $k) $w[$k] = ''; $w['dv_on'] = '0'; $chg[] = 'Dejavoo codes removed (Card on the P5 off)'; }
+            else {
+                $tpn = (string)preg_replace('/\D+/', '', (string)($dv['tpn'] ?? '')); $reg = trim((string)($dv['reg'] ?? '')); $auth = trim((string)($dv['auth'] ?? ''));
+                if ($tpn !== '' && (strlen($tpn) < 10 || strlen($tpn) > 12)) throw new RuntimeException('Dejavoo TPN: 10–12 digits.');
+                if ($reg !== '' && (strlen($reg) < 2 || strlen($reg) > 50)) throw new RuntimeException('Dejavoo Register ID: 2–50 characters.');
+                if ($auth !== '' && strlen($auth) !== 10) throw new RuntimeException('Dejavoo Auth Key: exactly 10 characters.');
+                if ($tpn !== '' && $tpn !== trim((string)($s['dv_tpn'] ?? ''))) { $w['dv_tpn'] = $tpn; $chg[] = 'Dejavoo TPN'; }
+                if ($reg !== '' && hq_dec_for($c, (string)($s['dv_reg'] ?? '')) !== $reg) { $w['dv_reg'] = hq_enc_for($c, $reg); $chg[] = 'Dejavoo Register ID'; }
+                if ($auth !== '' && hq_dec_for($c, (string)($s['dv_auth'] ?? '')) !== $auth) { $w['dv_auth'] = hq_enc_for($c, $auth); $chg[] = 'Dejavoo Auth Key'; }
+                if (array_key_exists('on', $dv)) { $on = !empty($dv['on']);
+                    $okDv = (($w['dv_tpn'] ?? trim((string)($s['dv_tpn'] ?? ''))) !== '' || ($w['dv_reg'] ?? (string)($s['dv_reg'] ?? '')) !== '') && ($w['dv_auth'] ?? (string)($s['dv_auth'] ?? '')) !== '';
+                    if ($on && !$okDv) throw new RuntimeException('Dejavoo: type the TPN and the Auth Key first.');
+                    if ($on !== ((string)($s['dv_on'] ?? '') === '1')) { $w['dv_on'] = $on ? '1' : '0'; $chg[] = 'Card on the P5 ' . ($on ? 'on' : 'off'); } }
+            }
+        }
+        foreach ($w as $k => $v) hq_put($p, $c, $k, $v);
+        if ($chg) { $what = implode(', ', $chg); hq_salon_audit($p, 'Card keys (set by NailFlow)', '', $what); hq_change(function (&$d) use ($id, $what) { hq_log($d, $id, 'card keys', '', $what); }); }
+        $s = hq_set($p, $c);
+        return ['ok' => true, 'id' => $id, 'name' => (string)($s['salon_name'] ?? $id), 'changed' => count($chg)] + hq_cards_info($c, $s);
+    }
+    return ['ok' => true, 'id' => $id, 'name' => (string)($s['salon_name'] ?? $id)] + hq_cards_info($c, $s);
+}
diff -ruN int659/inc/hq-keys.php int660z/inc/hq-keys.php
--- int659/inc/hq-keys.php	1969-12-31 18:00:00.000000000 -0600
+++ int660z/inc/hq-keys.php	2026-11-06 01:27:17.282479105 -0600
@@ -0,0 +1,115 @@
+<?php
+/* (2.99.660 keys) AN HQ is the ONLY place where a salon's secret keys / provider settings are set (owner decision 06/11): the SMS Server key (+ its salon id),
+   the Android SMS Gateway login (username / password / signing key) and PayPal (Client ID / Secret / Live or Sandbox). Same code for every salon, American Nails too.
+   Each secret is ENCRYPTED with THAT salon's own key – the same key its runtime ad_enc() / ad_dec() (inc/android.php ad_key) makes from its own config.php –
+   so the salon decrypts it by itself. A secret is never sent back to a page (only "saved ✓"), never logged (the audit / HQ log name WHAT changed, never the value).
+   The salon's Admin only sees a status line (Settings → Auto send, Settings → Deposits & PayPal). */
+declare(strict_types=1);
+
+/** The key of salon $c (its config.php array) = ad_key() run inside that salon. */
+function hq_salon_key(array $c): string { return hash('sha256', 'an-android|' . ($c['db_pass'] ?? '') . '|' . ($c['db_name'] ?? '') . '|' . ($c['db_user'] ?? '') . '|' . ($c['sqlite_path'] ?? ''), true); }
+/** Encrypt for salon $c (= ad_enc() of that salon: 's1:' sodium secretbox, or 'g1:' AES-256-GCM without sodium). */
+function hq_enc_for(array $c, string $plain): string {
+    if ($plain === '') return '';
+    $k = hq_salon_key($c);
+    if (function_exists('sodium_crypto_secretbox')) { $n = random_bytes(SODIUM_CRYPTO_SECRETBOX_NONCEBYTES); return 's1:' . base64_encode($n . sodium_crypto_secretbox($plain, $n, $k)); }
+    $iv = random_bytes(12); $tag = ''; $ct = openssl_encrypt($plain, 'aes-256-gcm', $k, OPENSSL_RAW_DATA, $iv, $tag);
+    return 'g1:' . base64_encode($iv . $tag . $ct);
+}
+/** Decrypt a value of salon $c (= ad_dec() of that salon) – used here only to compare (a value typed again unchanged is not re-saved). */
+function hq_dec_for(array $c, string $box): string {
+    if ($box === '') return '';
+    $raw = base64_decode(substr($box, 3), true); if ($raw === false) return ''; $k = hq_salon_key($c);
+    if (str_starts_with($box, 's1:') && function_exists('sodium_crypto_secretbox_open')) { $p = @sodium_crypto_secretbox_open(substr($raw, SODIUM_CRYPTO_SECRETBOX_NONCEBYTES), substr($raw, 0, SODIUM_CRYPTO_SECRETBOX_NONCEBYTES), $k); return $p === false ? '' : $p; }
+    if (str_starts_with($box, 'g1:')) { $p = openssl_decrypt(substr($raw, 28), 'aes-256-gcm', $k, OPENSSL_RAW_DATA, substr($raw, 0, 12), substr($raw, 12, 16)); return $p === false ? '' : $p; }
+    return '';
+}
+/** A PayPal secret as saved: encrypted ('s1:' / 'g1:') since 2.99.660, plain before. */
+function hq_pp_plain(array $c, string $v): string { return (str_starts_with($v, 's1:') || str_starts_with($v, 'g1:')) ? hq_dec_for($c, $v) : $v; }
+function hq_ws_fp(string $k): string { return $k === '' ? '' : strtoupper(substr(hash('sha256', 'nf-ws|' . $k), 0, 8)); } /* = ws_key_fp() of the salon */
+
+/** The texting keys of a salon for HQ: only whether each one is saved (never a value). */
+function hq_tx_keys_info(array $s): array {
+    return ['wsKey' => (string)($s['ws_key'] ?? '') !== '', 'wsId' => (string)($s['ws_salon_id'] ?? ''), 'wsOn' => (string)($s['ad_transport'] ?? '') === 'winsms',
+        'adUser' => (string)($s['ad_user'] ?? '') !== '', 'adPass' => (string)($s['ad_pass'] ?? '') !== '', 'adSign' => (string)($s['ad_sign'] ?? '') !== '', 'shared' => (string)($s['ad_share'] ?? '') !== ''];
+}
+/** HQ → 🔑 Keys → Texting: set { ws_id, ws_key, ws_clear, ad_user, ad_pass, ad_sign, ad_clear } of salon $id. An empty field keeps what is saved. All checked first, then saved. */
+function hq_tx_keys(string $id, array $set): array {
+    $sl = hq_salon($id); $c = hq_cfg($sl['root']); if (!$c) throw new RuntimeException('No config for this salon.'); $p = hq_pdo($c); $s = hq_set($p, $c);
+    $wsId = strtolower(trim((string)($set['ws_id'] ?? ''))); $wsKey = trim((string)($set['ws_key'] ?? ''));
+    if ($wsId !== '' && !preg_match('/^[a-z0-9_-]{1,32}$/', $wsId)) throw new RuntimeException('SMS Server salon id: letters / numbers only (like "an").');
+    if ($wsKey !== '' && (strlen($wsKey) < 24 || strlen($wsKey) > 200 || preg_match('/\s/', $wsKey))) throw new RuntimeException('The SMS Server key looks wrong (24+ characters, no spaces).');
+    $ad = [];
+    foreach (['ad_user' => 'Android username', 'ad_pass' => 'Android password', 'ad_sign' => 'Android signing key'] as $k => $say) { $v = trim((string)($set[$k] ?? '')); if ($v === '') continue;
+        if (mb_strlen($v) > 200 || preg_match('/\s/', $v)) throw new RuntimeException($say . ': no spaces, up to 200 characters.'); $ad[$k] = [$v, $say]; }
+    if ($ad && (string)($s['ad_share'] ?? '') !== '') throw new RuntimeException('This salon uses another salon\'s Android – choose "Android riêng" in 📲 Tin nhắn first.');
+    $chg = []; $adChg = false;
+    if ($wsId !== '' && $wsId !== (string)($s['ws_salon_id'] ?? '')) { hq_put($p, $c, 'ws_salon_id', $wsId); $chg[] = 'SMS Server salon id ' . $wsId; }
+    if (!empty($set['ws_clear'])) { if ((string)($s['ws_key'] ?? '') !== '') { hq_put($p, $c, 'ws_key', ''); $chg[] = 'SMS Server key removed'; } }
+    elseif ($wsKey !== '' && hq_dec_for($c, (string)($s['ws_key'] ?? '')) !== $wsKey) { hq_put($p, $c, 'ws_key', hq_enc_for($c, $wsKey)); $chg[] = 'SMS Server key ' . hq_ws_fp($wsKey); }
+    if (!empty($set['ad_clear'])) { foreach (['ad_user', 'ad_pass', 'ad_sign', 'ad_tok', 'ad_check'] as $k) hq_put($p, $c, $k, ''); $chg[] = 'Android login removed'; $adChg = true; }
+    else foreach ($ad as $k => [$v, $say]) if (hq_dec_for($c, (string)($s[$k] ?? '')) !== $v) { hq_put($p, $c, $k, hq_enc_for($c, $v)); $chg[] = $say; $adChg = true; }
+    if ($adChg) foreach (['ad_tok', 'ad_basic_until', 'ad_hooks_n', 'ad_hooks_try'] as $k) hq_put($p, $c, $k, ''); /* the old login's tokens go; the salon's cron registers the webhooks again (ad_hooks_upgrade) */
+    if ($chg) { $what = implode(', ', $chg); hq_salon_audit($p, 'Texting keys (set by NailFlow)', '', $what); hq_change(function (&$d) use ($id, $what) { hq_log($d, $id, 'texting keys', '', $what); }); }
+    return ['ok' => true, 'changed' => count($chg), 'keys' => hq_tx_keys_info(hq_set($p, $c))];
+}
+
+/** HQ → 🔑 Keys → PayPal of salon $id. GET: only whether each key is saved (+ the last 4 of the Client ID). set { client_id, secret, mode, clear }: an empty field keeps what is saved.
+    The Client ID stays plain (the booking / gift pages give it to PayPal's buttons); the Secret is saved ENCRYPTED with that salon's key (inc/paypal.php pp_secret reads both). */
+function hq_paypal(string $id, ?array $set = null): array {
+    $sl = hq_salon($id); $c = hq_cfg($sl['root']); if (!$c) throw new RuntimeException('No config for this salon.'); $p = hq_pdo($c); $s = hq_set($p, $c);
+    if ($set !== null) { $chg = [];
+        if (!empty($set['clear'])) { foreach (['paypal_client_id' => '', 'paypal_secret' => '', 'dep_on' => '0', 'gift_online' => '0'] as $k => $v) hq_put($p, $c, $k, $v); $chg[] = 'PayPal keys removed (group deposits + online gift cards off)'; }
+        else {
+            $cid = trim((string)($set['client_id'] ?? '')); $sec = trim((string)($set['secret'] ?? ''));
+            foreach ([$cid, $sec] as $v) if ($v !== '' && (strlen($v) > 128 || preg_match('/\s/', $v))) throw new RuntimeException('PayPal Client ID / Secret: no spaces, up to 128 characters.');
+            if (array_key_exists('mode', $set)) { $m = (string)$set['mode'] === 'sandbox' ? 'sandbox' : 'live'; if ($m !== ((string)($s['paypal_mode'] ?? '') === 'sandbox' ? 'sandbox' : 'live')) { hq_put($p, $c, 'paypal_mode', $m); $chg[] = 'PayPal mode ' . $m; } }
+            if ($cid !== '' && $cid !== trim((string)($s['paypal_client_id'] ?? ''))) { hq_put($p, $c, 'paypal_client_id', $cid); $chg[] = 'PayPal Client ID …' . substr($cid, -4); }
+            if ($sec !== '' && hq_pp_plain($c, (string)($s['paypal_secret'] ?? '')) !== $sec) { hq_put($p, $c, 'paypal_secret', hq_enc_for($c, $sec)); $chg[] = 'PayPal Secret'; }
+        }
+        if ($chg) { $what = implode(', ', $chg); hq_salon_audit($p, 'PayPal keys (set by NailFlow)', '', $what); hq_change(function (&$d) use ($id, $what) { hq_log($d, $id, 'PayPal keys', '', $what); }); }
+        $s = hq_set($p, $c); $n = count($chg); /* (2.99.660 push) the page says "Saved ✓" only when something changed */
+    }
+    $cid = trim((string)($s['paypal_client_id'] ?? '')); $sec = (string)($s['paypal_secret'] ?? '');
+    return ['ok' => true, 'changed' => $n ?? 0, /* (2.99.660 push) */ 'id' => $id, 'name' => (string)($s['salon_name'] ?? $id), 'clientSet' => $cid !== '', 'clientEnd' => $cid !== '' ? substr($cid, -4) : '', 'secretSet' => trim($sec) !== '',
+        'ready' => $cid !== '' && trim($sec) !== '', 'mode' => (string)($s['paypal_mode'] ?? '') === 'sandbox' ? 'sandbox' : 'live', 'depOn' => (string)($s['dep_on'] ?? '') === '1', 'giftOnline' => (string)($s['gift_online'] ?? '') === '1'];
+}
+
+/* (2.99.660 push) HQ → 🔑 Keys → Firebase (push) of salon $id: the NailFlow app's Firebase service-account key, slot 1 (fcm_sa, the old project) and slot 2
+   (fcm_sa2, the new app's project an-salon-push). The salon no longer uploads it (inc/api/notify.php fcm_key + pushtech.php which=sa refuse) – set ONLY here.
+   Saved like the old salon code (inc/fcm.php fcm_set_key): only type / project_id / client_email / private_key / token_uri, ENCRYPTED with that salon's key
+   (its fcm_key() opens it with ad_dec), fcm_project<slot> = the project id, the cached access token fcm_tok<slot> cleared. A cleared slot falls back to the
+   HQ file (fcm_file_key) like before; the shared slot-2 file is NOT touched here (it serves every salon). GET / answer: saved yes/no + project id, never a key. */
+function hq_push_info(array $s): array {
+    $o = ['ok' => true];
+    foreach (['1' => '', '2' => '2'] as $n => $sl) $o['slot' . $n] = ['saved' => (string)($s['fcm_sa' . $sl] ?? '') !== '', 'project' => (string)($s['fcm_project' . $sl] ?? '')];
+    return $o;
+}
+/** set { slot1, slot2 } = the .json text (replace), { clear1, clear2 } = remove. All checked first, then saved. */
+function hq_push_keys(string $id, ?array $set = null): array {
+    $sl = hq_salon($id); $c = hq_cfg($sl['root']); if (!$c) throw new RuntimeException('No config for this salon.'); $p = hq_pdo($c); $s = hq_set($p, $c);
+    if ($set !== null) { $put = [];
+        foreach (['1' => '', '2' => '2'] as $n => $slot) {
+            if (!empty($set['clear' . $n])) { $put[$slot] = null; continue; }
+            $t = trim((string)($set['slot' . $n] ?? '')); if ($t === '') continue;
+            if (strlen($t) > 20000) throw new RuntimeException('Firebase key (slot ' . $n . '): file too big.');
+            $j = json_decode($t, true);
+            if (!is_array($j) || ($j['type'] ?? '') !== 'service_account' || empty($j['client_email']) || empty($j['project_id']) || !is_string($j['private_key'] ?? null) || !@openssl_pkey_get_private($j['private_key']))
+                throw new RuntimeException('Slot ' . $n . ': this is not a Firebase service-account key (Firebase → Project settings → Service accounts → Generate new private key → the .json file).');
+            $put[$slot] = ['type' => 'service_account', 'project_id' => (string)$j['project_id'], 'client_email' => (string)$j['client_email'], 'private_key' => (string)$j['private_key'], 'token_uri' => (string)($j['token_uri'] ?? '')];
+        }
+        $chg = [];
+        foreach ($put as $slot => $keep) { $n = $slot === '2' ? '2' : '1';
+            if ($keep === null) { if ((string)($s['fcm_sa' . $slot] ?? '') === '') continue;
+                foreach (['fcm_sa', 'fcm_project', 'fcm_tok'] as $k) hq_put($p, $c, $k . $slot, ''); $chg[] = 'Firebase key slot ' . $n . ' removed'; continue; }
+            $js = (string)json_encode($keep);
+            if (hq_dec_for($c, (string)($s['fcm_sa' . $slot] ?? '')) === $js) continue;
+            hq_put($p, $c, 'fcm_sa' . $slot, hq_enc_for($c, $js)); hq_put($p, $c, 'fcm_project' . $slot, $keep['project_id']); hq_put($p, $c, 'fcm_tok' . $slot, '');
+            $chg[] = 'Firebase key slot ' . $n . ' · project ' . $keep['project_id'];
+        }
+        if ($chg) { $what = implode(', ', $chg); hq_salon_audit($p, 'Firebase push keys (set by NailFlow)', '', $what); hq_change(function (&$d) use ($id, $what) { hq_log($d, $id, 'Firebase push keys', '', $what); }); }
+        $s = hq_set($p, $c);
+        return ['changed' => count($chg)] + hq_push_info($s);
+    }
+    return hq_push_info($s);
+}
