+      if ($('#kAdClr')) $('#kAdClr').onclick = (ev) => { if (ev.target.dataset.sure !== '1') { ev.target.dataset.sure = '1'; ev.target.textContent = 'Tap again to remove'; return; } tx(ev.target, { ad_clear: 1 }, 'Android login removed'); };
+      if ($('#kWsClr')) $('#kWsClr').onclick = (ev) => { if (ev.target.dataset.sure !== '1') { ev.target.dataset.sure = '1'; ev.target.textContent = 'Tap again to remove'; return; } tx(ev.target, { ws_clear: 1 }, 'SMS Server key removed'); };
+      const pp = async (btn, set, say) => { busy(btn, true); try { P = await api('paypal', { id: s.id, set }); toast(P.changed ? say : 'Nothing changed'); /* (2.99.660 push) like the texting keys */ draw(); } catch (y) { toast(y.message, true); busy(btn, false); } };
+      $('#kPpSave').onclick = (ev) => pp(ev.target, { mode: $('#kPpMode').value, client_id: $('#kPpCid').value.trim(), secret: $('#kPpSec').value.trim() }, 'Saved ✓');
+      const fb = async (btn, set, say) => { busy(btn, true); try { F = await api('push_keys', { id: s.id, set }); toast(F.changed ? say : 'Nothing changed'); draw(); } catch (y) { toast(y.message, true); busy(btn, false); } }; /* (2.99.660 push) */
+      $('#kFbSave').onclick = async (ev) => { const set = {}; for (const n of ['1', '2']) { const f = ($('#kFb' + n).files || [])[0]; if (f) set['slot' + n] = await f.text(); } if (!Object.keys(set).length) return toast('Choose a .json file first', true); fb(ev.target, set, 'Saved ✓'); };
+      for (const n of ['1', '2']) if ($('#kFbClr' + n)) $('#kFbClr' + n).onclick = (ev) => { if (ev.target.dataset.sure !== '1') { ev.target.dataset.sure = '1'; ev.target.textContent = 'Tap again to remove'; return; } fb(ev.target, { ['clear' + n]: 1 }, 'Slot ' + n + ' key removed'); };
+      if ($('#kPpClr')) $('#kPpClr').onclick = (ev) => { if (ev.target.dataset.sure !== '1') { ev.target.dataset.sure = '1'; ev.target.textContent = 'Tap again – deposits + online gift cards go off'; return; } pp(ev.target, { clear: 1 }, 'PayPal keys removed'); };
+    };
+    draw();
+  }
