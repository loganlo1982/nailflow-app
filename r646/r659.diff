+<?php
+/* (2.99.659 - anh Logan 05/11 23:57 "Telnyx setup chi co HQ moi duoc lam") AN HQ -> THIS salon: run ONE Telnyx "Set up automatically" step (key, ovp, app, num, ai)
+   here, in the salon's own code (tx_setup_step in inc/calls-tx.php: its own address, its own TeXML application / AI assistant, its own settings).
+   Only AN HQ can ask: POST JSON {step, n} signed X-NF-HQ = HMAC-SHA256(this salon's own key - from ITS config, which only HQ on the same server reads - , "hq-tx|" + body);
+   n = milliseconds, within 2 minutes and newer than the last one (never replayed). Nothing secret comes in or goes out (the Telnyx key is HQ's shared file or the salon's own). */
+declare(strict_types=1);
+require __DIR__ . '/inc/core.php';
+header('Content-Type: application/json; charset=utf-8'); header('Cache-Control: no-store'); header('X-Robots-Tag: noindex, nofollow');
+$out = function (array $a, int $code = 200): void { http_response_code($code); echo json_encode($a, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE); exit; };
+if (($_SERVER['REQUEST_METHOD'] ?? '') !== 'POST') $out(['error' => 'POST only'], 405);
+if (!is_installed()) $out(['error' => 'Not installed'], 404);
+settings();
+require_once __DIR__ . '/inc/android.php';
+$raw = (string)file_get_contents('php://input'); $sig = (string)($_SERVER['HTTP_X_NF_HQ'] ?? '');
+if ($raw === '' || strlen($raw) > 2000 || !preg_match('/^[a-f0-9]{64}$/', $sig) || !hash_equals(hash_hmac('sha256', 'hq-tx|' . $raw, ad_key()), $sig)) $out(['error' => 'Not allowed'], 403);
+$in = json_decode($raw, true); $in = is_array($in) ? $in : [];
+$n = (int)($in['n'] ?? 0); $step = (string)($in['step'] ?? '');
+if (abs(intdiv($n, 1000) - time()) > 120 || $n <= (int)setting('tx_hq_n')) $out(['error' => 'Too old – try again.'], 403);
+set_setting('tx_hq_n', (string)$n);
+require_once __DIR__ . '/inc/calls-tx.php'; require_once __DIR__ . '/inc/calls-agent.php'; require_once __DIR__ . '/inc/calls-ivr.php'; /* = Settings → Calls → tx_setup */
+if (!in_array($step, TX_STEPS, true)) $out(['error' => 'Unknown step.'], 400);
+@set_time_limit(60);
+$r = tx_setup_step($step);
+if (function_exists('audit')) { try { audit('setting', 'tx_setup', '', 'AN HQ: ' . $r['t'] . ($r['ok'] ? ' OK' : ' ERROR')); } catch (Throwable $e) {} }
+$out(['ok' => true, 'step' => $r, 'steps' => TX_STEPS]);
