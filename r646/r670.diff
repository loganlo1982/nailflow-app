+function txa_due(): bool { foreach (txa_q_read() as $e) if ((int)($e['next'] ?? 0) <= time()) return true; return false; }
+/** (2.99.670) call_in.php?a=tatick (signed with this server's minute token): it answers at once and works after. */
+function txa_poke(): void {
+    if (!function_exists('cl_tick_token')) require_once __DIR__ . '/calls.php';
+    $u = pub_url() . '/call_in.php?a=tatick&t=' . cl_tick_token(); if (!preg_match('#^https?://#', $u)) return;
