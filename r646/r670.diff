+        for ($i = 0; $i < $max; $i++) {
+            settings(true); $l = txa_q_read(); $pick = null;
+            foreach ($l as $p => $e) if ((int)($e['next'] ?? 0) <= time()) { $pick = (string)$p; break; }
+            if ($pick === null) break;
