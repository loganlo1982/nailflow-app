+/* (2.99.670 review – 5) ONE short lock around every read-modify-write of the queue (txa_q_add in the webhook, txa_run after each job): two texts at once
+   (two numbers, or a text while a job ends) never overwrite each other's entry. Only around the setting (never the AI): the webhook waits milliseconds. */
+function txa_qlock() { $c = cfg(); $h = @fopen(sys_get_temp_dir() . '/nf-taq-' . (defined('SITE_ID') ? SITE_ID : 'x') . '-' . substr(md5((string)($c['sqlite_path'] ?? '') . ($c['db_name'] ?? '')), 0, 8) . '.lock', 'c'); if ($h) flock($h, LOCK_EX); return $h; }
