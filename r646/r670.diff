+function txa_run(int $max = 10): array {
+    $lk = @fopen(sys_get_temp_dir() . '/nf-ta-' . (defined('SITE_ID') ? SITE_ID : 'x') . '-' . substr(md5((string)(cfg()['sqlite_path'] ?? '') . (cfg()['db_name'] ?? '')), 0, 8) . '.lock', 'c');
+    if ($lk) flock($lk, LOCK_EX);
