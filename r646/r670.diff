+/* ---------- the queue ---------- */
+function txa_q_read(): array { $v = q("SELECT v FROM settings WHERE k = 'ta_q'")->fetchColumn(); $l = json_decode((string)$v, true); return is_array($l) ? $l : []; }
+function txa_q_write(array $l): void { set_setting('ta_q', json_encode((object)$l, JSON_UNESCAPED_UNICODE)); }
