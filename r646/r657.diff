+    $party = array_values(array_filter((array)($j['party'] ?? []), 'is_array'));
+    $who = $party ?: [['service_ids' => (array)($j['service_ids'] ?? []), 'service_text' => (string)($j['service_text'] ?? '')]];
+    foreach ($who as $p) {
+        $cand = trim((string)($p['service_text'] ?? '')); foreach ((array)($p['service_ids'] ?? []) as $id) $cand .= ' ' . ($names[(int)$id] ?? '');
+        $hit = false; foreach (array_unique(explode(' ', cl_norm($cand))) as $t) if (strlen($t) >= 3 && !in_array($t, $skip, true) && str_contains($w, ' ' . $t . ' ')) { $hit = true; break; }
+        if (!$hit) return false;
+    }
+    return true;
+}
