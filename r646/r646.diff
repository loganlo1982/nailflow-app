+    set_setting('sms_cancel', "OWNER 💅 nail tech {tech} cancelled"); $r['owner_tpl'] = setting('sms_cancel');
+    $a = ['customer_name' => 'Tech Nails', 'phone' => '+15550100001', 'appt_date' => date('Y-m-d', time() + 86400), 'start_min' => 600, 'staff_id' => 0, 'duration' => 30, 'service_ids' => '', 'token' => 'x', 'group_id' => '', 'id' => 1];
