+    $r['book_show_price'] = setting('book_show_price'); $r['turn_auto_on'] = setting('turn_auto_on');
+    require_once APP_ROOT . '/inc/turnauto.php'; $r['ta_on'] = ta_on();
+    require_once APP_ROOT . '/inc/api/_out.php'; $r['quick'] = quick_default('Spa Pedicure');
+    $r['seo'] = seo_title(); $r['flag_js'] = salon_type_js(); $r['words_tag'] = hair_words_tag('../');
