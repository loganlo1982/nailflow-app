+      card.innerHTML = `<h3 style="margin-top:0">${LV('Who assigns the turns', 'Ai chia turn')}</h3>`
+        + rb('0', !on, `<b>1. ${LV('The owner / front desk assigns the turns', 'Chủ tiệm / quầy tự chia turn')}</b> – ${LV('the app does not give walk-ins by itself (it only shows the line). The turn rules are hidden, still saved.', 'app không tự giao khách (chỉ hiện hàng turn). Luật turn được ẩn, vẫn giữ nguyên.')}`)
+        + rb('1', on, `<b>2. ${LV('The app assigns the turns', 'App chia turn')}</b> – ${LV('tick the turn rules below and tap Save; the app follows them.', 'chọn luật turn bên dưới rồi bấm Save, app làm theo.')}`)
+        + `<div id="tmMsg"></div>`;
+      const first = b.querySelector('#trCard') || b.firstElementChild; if (first && first.parentNode) first.parentNode.insertBefore(card, first); else b.appendChild(card);
+      const show = (app) => { ['#trCard', '#teCard'].forEach(q => { const el = b.querySelector(q); if (el) el.hidden = !app; }); };
+      const pick = (app) => { const x = card.querySelector(`[name=tmMode][value="${app ? '1' : '0'}"]`); if (x) x.checked = true; };
+      show(on);
+      card.querySelectorAll('[name=tmMode]').forEach(x => x.addEventListener('change', async () => {
+        const app = x.value === '1', au = b.querySelector('#tuAuto'), was = au ? au.checked : !app;
+        try { await api('save_settings', { turn_auto_on: app }); if (au) au.checked = app; show(app); saved(); }
+        catch (e) { pick(was); show(was); oops(e); }
+      }));
+      const au = b.querySelector('#tuAuto'); /* the old switch lower down stays; both show the same value */
+      if (au) au.addEventListener('change', () => { pick(au.checked); show(au.checked); });
+    } catch (e) { /* the page still works without it */ }
+    return r;
+  };
+  for (const k of Object.keys(orig)) wrap[k] = orig[k];
