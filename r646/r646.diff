+'use strict';
+(function () {
+  const orig = SET_PAGES.turn;
+  if (typeof orig !== 'function' || orig.__mode) return;
+  const wrap = function (b, s) {
+    const r = orig.apply(this, arguments);
+    try {
+      const c = (s && s.turn_cfg) || {}, on = c.autoOn !== false;
+      const card = document.createElement('div'); card.className = 'card'; card.id = 'tmCard'; card.style.marginBottom = '12px';
