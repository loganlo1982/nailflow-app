+        require_once APP_ROOT . '/inc/hair.php'; $m = hair_menu_apply(false, 'hair'); $r['menu'] = $m['services'] . '/' . $m['groups'];
+        $r['menu_db'] = (int)q('SELECT COUNT(*) FROM services WHERE active = 1')->fetchColumn(); $r['groups_db'] = count((array)json_decode(setting('svc_groups'), true));
+        require_once APP_ROOT . '/inc/svc-tpl.php'; $r['tpl_again'] = svc_tpl_add();
+        set_setting('ios_in_key', str_repeat('ab', 16));
+        $code = 'define("APP_ROOT", ' . var_export($root, true) . '); $_SERVER["REQUEST_METHOD"] = "GET"; $_SERVER["HTTP_HOST"] = "localhost"; $_SERVER["HTTP_X_IOS_KEY"] = "' . str_repeat('ab', 16) . '"; $_GET = ["action" => "ios_in", "from" => "+15550100009", "text" => "hello there"]; chdir(' . var_export($root, true) . '); require ' . var_export($root . '/api.php', true) . ';';
