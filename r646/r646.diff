+<?php
+/* (2.99.646 - LENH 646 hair) ported from the hair fork 2.99.408.11 (hair 1 – 25/10/2026, anh Logan): TIỆM TÓC – settings of a hair salon only
+   (setting 'hair_cfg', JSON) + the sample hair menu. Loaded only by inc/api/hair.php, whose actions answer only when is_hair() – a nail salon never uses it. */
+declare(strict_types=1);
+
+function hair_defaults(): array {
+    return [
+        'kind' => 'hair',            /* hair | barber | unisex */
+        'price_from' => true,        /* booking page: "from $55" */
+        'len_on' => false, 'len' => ['short' => 0, 'medium' => 10, 'long' => 20, 'xlong' => 35],   /* length surcharge $ */
+        'lvl_on' => false, 'lvl' => ['junior' => 0, 'senior' => 15, 'master' => 30],               /* stylist level +% */
+        'proc_on' => true, 'proc_min' => 30, 'proc_book' => true,   /* color processing time; stylist can take another client meanwhile */
+        'clean_min' => 10,           /* clean-up minutes between clients */
+        'pick_stylist' => 'optional', /* optional | required | any */
+        'consult_on' => true, 'consult_min' => 15, 'consult_color' => true,
+        'patch_on' => true, 'patch_h' => 48,
+        'dep_on' => false, 'dep_type' => 'pct', 'dep_val' => 20, 'dep_from' => 100, 'dep_color' => true, 'dep_ext' => true,
+        'cxl_h' => 24, 'noshow_fee' => 0, 'late_min' => 15,
+        'pay_model' => 'commission', 'comm_pct' => 45, 'booth_amt' => 200, 'booth_day' => 'mon', 'hourly' => 15, 'card_fee_pct' => 0,
+        'retail_on' => false, 'retail_pct' => 10,
+        'formula_on' => true, 'formula_tech' => true, 'notes_on' => true, 'photos_on' => true,
+        'rebook_on' => true, 'rebook' => ['cut' => 35, 'color' => 49, 'highlight' => 70, 'texture' => 90, 'treat' => 30, 'beard' => 21],
+        'walkin' => 'first', 'show_wait' => true,
+        'prep_on' => true, 'prep_txt' => 'Please come with dry, brushed hair. For color: no washing 24 hours before.',
+        'after_on' => true, 'after_txt' => 'Thank you! For your new color: wait 48 hours before washing, use color-safe shampoo and cool water.',
+        'first_disc' => 0, 'rebook_disc' => 0, 'bday_disc' => 0,
+        'android_on' => false,       /* texts sent by an Android phone automatically – OFF: only when the salon asks for it */
+    ];
+}
+
+function hair_cfg(): array {
+    $d = hair_defaults(); $s = json_decode((string)setting('hair_cfg'), true);
+    if (!is_array($s)) return $d;
+    foreach ($d as $k => $v) {
+        if (!array_key_exists($k, $s)) continue;
+        if (is_array($v)) { foreach ($v as $kk => $vv) if (isset($s[$k][$kk])) $d[$k][$kk] = (int)$s[$k][$kk]; }
+        else $d[$k] = $s[$k];
+    }
+    return $d;
+}
+
+/** Checks every value (all or nothing) and saves. Returns the saved settings. */
+function hair_save(array $in): array {
+    $d = hair_defaults(); $old = hair_cfg(); $o = $old;
+    $num = ['proc_min' => [0, 240], 'clean_min' => [0, 60], 'consult_min' => [5, 60], 'patch_h' => [24, 72], 'dep_val' => [0, 1000], 'dep_from' => [0, 5000],
+        'cxl_h' => [0, 168], 'noshow_fee' => [0, 500], 'late_min' => [0, 60], 'comm_pct' => [0, 100], 'booth_amt' => [0, 5000], 'hourly' => [0, 200],
+        'card_fee_pct' => [0, 10], 'retail_pct' => [0, 50], 'first_disc' => [0, 50], 'rebook_disc' => [0, 50], 'bday_disc' => [0, 50]];
+    $pick = ['kind' => ['hair', 'barber', 'unisex'], 'pick_stylist' => ['optional', 'required', 'any'], 'dep_type' => ['pct', 'amt'],
+        'pay_model' => ['commission', 'booth', 'hourly', 'mix'], 'booth_day' => ['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'], 'walkin' => ['first', 'choice', 'least']];
+    foreach ($in as $k => $v) {
+        if (!array_key_exists($k, $d)) continue;
+        if (isset($num[$k])) { $n = round((float)$v, 2); [$lo, $hi] = $num[$k]; if ($n < $lo || $n > $hi) fail("$k: $lo – $hi."); $o[$k] = $n; }
+        elseif (isset($pick[$k])) $o[$k] = in_array((string)$v, $pick[$k], true) ? (string)$v : $d[$k];
+        elseif (is_bool($d[$k])) $o[$k] = !empty($v);
+        elseif (is_array($d[$k])) { foreach ($d[$k] as $kk => $vv) if (isset($v[$kk])) { $n = (int)$v[$kk]; if ($n < 0 || $n > ($k === 'lvl' ? 100 : ($k === 'len' ? 500 : 365))) fail("$k $kk: số không hợp lệ."); $o[$k][$kk] = $n; } }
+        else $o[$k] = trim(mb_substr((string)$v, 0, 400));
+    }
+    set_setting('hair_cfg', json_encode($o, JSON_UNESCAPED_UNICODE));
+    if ($o !== $old && function_exists('audit')) audit('setting', 'Hair salon rules', '', 'saved');
+    return $o;
+}
+
+/** The sample hair menu: [group name, Spanish, icon, rebook key, [[name, minutes, price], …]]. Prices are samples – the owner changes them. */
+function hair_menu_sample(string $kind = 'hair'): array {
+    $m = [
+        ['CUT', 'Corte', '✂️', 'cut', [["Women's Haircut", 60, 55], ["Men's Haircut", 30, 30], ['Kids Haircut (12 & under)', 30, 22], ['Bang Trim', 15, 10]]],
+        ['COLOR', 'Color', '🎨', 'color', [['Root Touch-Up', 90, 75], ['All-Over Color', 120, 95], ['Toner / Gloss', 45, 45], ['Color Correction (consult first)', 180, 180]]],
+        ['HIGHLIGHTS', 'Mechas', '✨', 'highlight', [['Partial Highlights', 120, 110], ['Full Highlights', 150, 150], ['Balayage', 180, 185]]],
+        ['TEXTURE', 'Textura', '🌀', 'texture', [['Perm', 120, 95], ['Keratin Smoothing', 150, 200]]],
+        ['STYLE', 'Peinado', '💨', '', [['Blowout', 45, 40], ['Wash & Style', 30, 30], ['Updo / Event Style', 60, 75]]],
+        ['TREATMENT', 'Tratamiento', '💧', 'treat', [['Deep Conditioning', 20, 25], ['Scalp Treatment', 30, 35]]],
+        ['EXTENSIONS', 'Extensiones', '🧵', '', [['Extensions Consultation', 15, 0], ['Tape-In Move-Up', 90, 120]]],
+        ['BARBER', 'Barbería', '🪒', 'beard', [['Beard Trim', 20, 18], ['Hot Towel Shave', 30, 35], ['Fade', 45, 35]]],
+    ];
+    if ($kind === 'barber') $m = array_values(array_filter($m, fn($g) => in_array($g[0], ['CUT', 'STYLE', 'BARBER', 'COLOR'], true)));
+    if ($kind === 'hair') $m = array_values(array_filter($m, fn($g) => $g[0] !== 'BARBER'));
+    return $m;
+}
+
+/** Puts the sample hair menu in (services + groups). $replace = the services there now are turned off first.
+    (2.99.646 - LENH 646 hair) all or nothing: one transaction (the hair fork could leave the old menu off and half a new one), one at a time (app_lock). */
+function hair_menu_apply(bool $replace, string $kind = 'hair'): array {
+    if (!is_hair()) fail('Only a hair salon.', 403);
+    app_lock('hair_menu');
+    $has = (int)q('SELECT COUNT(*) FROM services WHERE active = 1')->fetchColumn();
+    if ($has > 0 && !$replace) fail('Đã có dịch vụ – chọn "Thay menu" để thay. · Services already exist.');
+    $cfg = hair_cfg(); $rb = $cfg['rebook']; $colors = ['CUT' => '#3472B9', 'COLOR' => '#B94A7E', 'HIGHLIGHTS' => '#C98A1B', 'TEXTURE' => '#6A4FB3', 'STYLE' => '#2E8B6E', 'TREATMENT' => '#2A8FB8', 'EXTENSIONS' => '#8A5A3C', 'BARBER' => '#444C5C'];
+    $groups = []; $sort = 0; $n = 0; $pdo = db();
+    $pdo->beginTransaction();
+    try {
+        if ($replace) q('UPDATE services SET active = 0, sort = 9999 WHERE active = 1');
+        foreach (hair_menu_sample($kind) as [$g, $ges, $icon, $rk, $items]) {
+            $ids = [];
+            foreach ($items as [$name, $min, $price]) {
+                $sort++; $n++;
+                $sh = mb_strtoupper(mb_substr(preg_replace('/[^A-Za-z ]/', '', $name), 0, 10));
+                q('INSERT INTO services (name, duration, price, color, sort, turn_value, return_days, name_es, design, short_name) VALUES (?, ?, ?, ?, ?, 0, ?, ?, 0, ?)',
+                    [$name, $min, $price, $colors[$g] ?? '#3472B9', $sort, $rk !== '' ? (int)($rb[$rk] ?? 0) : 0, '', $sh]);
+                $ids[] = (int)$pdo->lastInsertId();
+            }
+            $groups[] = ['name' => $g, 'name_es' => $ges, 'icon' => $icon, 'kind' => 'other', 'ids' => $ids, 'note' => '', 'note_es' => '', 'hidden' => 0];
+        }
+        set_setting('svc_groups', json_encode($groups, JSON_UNESCAPED_UNICODE));
+        $pdo->commit();
+    } catch (Throwable $e) { if ($pdo->inTransaction()) $pdo->rollBack(); settings(true); throw $e; }
+    if (function_exists('skills_sync')) { try { skills_sync(); } catch (Throwable $e) {} }
+    if (function_exists('audit')) audit('price', 'Hair sample menu', $replace ? 'replaced' : 'new', $n . ' services', 'Settings → Hair salon');
+    return ['services' => $n, 'groups' => count($groups)];
+}
