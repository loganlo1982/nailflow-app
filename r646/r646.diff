@@ -0,0 +1,42 @@
+<?php
+/* (2.99.646 - LENH 646 hair) ported from the hair fork 2.99.408.11 (hair 1 – 25/10/2026): api.php actions of a HAIR salon only – Settings → ✂️ Hair salon rules,
+   the sample hair menu, ios_in (a customer's text forwarded by the owner's iPhone Shortcut). A nail salon (salon_type not 'hair'): every action here = 404. */
+declare(strict_types=1);
+if (!defined('API_MAIN')) { http_response_code(404); exit; }
+if (!is_hair()) fail('Unknown action', 404);
+require_once APP_ROOT . '/inc/hair.php';
+switch ($action) {
+
+case 'hair_get':
+    need_admin();
+    if (strlen((string)setting('ios_in_key')) < 24) set_setting('ios_in_key', bin2hex(random_bytes(16)));
+    json_out(['cfg' => hair_cfg(), 'iosUrl' => rtrim(site_url(), '/') . '/api.php?action=ios_in&k=' . setting('ios_in_key'), 'iosLast' => (string)setting('ios_in_last'), 'services' => (int)q('SELECT COUNT(*) FROM services WHERE active = 1')->fetchColumn(),
+        'sample' => array_map(fn($g) => ['name' => $g[0], 'icon' => $g[2], 'items' => array_map(fn($i) => ['name' => $i[0], 'min' => $i[1], 'price' => $i[2]], $g[4])], hair_menu_sample(hair_cfg()['kind']))]);
+
+case 'hair_save':
+    need_admin();
+    if ($method !== 'POST') fail('POST only', 405);
+    json_out(['ok' => true, 'cfg' => hair_save((array)($in['cfg'] ?? []))]);
+
+case 'ios_in': /* a customer's text that came to the OWNER's iPhone, sent here by an iPhone Shortcut automation ("Message contains cancel") – no Android */
+    /* (2.99.646 - LENH 646 hair) rate limit per device (the fork had none: the key could be guessed without end); the key also in a header X-Ios-Key (not in logs) */
+    if (lookup_limited('IOS', 30, 600)) fail('Too many tries. Wait a few minutes.', 429);
+    $k = (string)($_SERVER['HTTP_X_IOS_KEY'] ?? ''); if ($k === '') $k = (string)($_GET['k'] ?? '');
+    $key = (string)setting('ios_in_key');
+    if (strlen($key) < 24 || !hash_equals($key, $k)) { http_response_code(404); exit; }
+    $from = trim((string)($in['from'] ?? $_POST['from'] ?? $_GET['from'] ?? '')); $text = trim((string)($in['text'] ?? $_POST['text'] ?? $_GET['text'] ?? ''));
+    if (preg_match_all('/\d/', $from) < 10) fail('No phone number (from).');
+    if ($text === '') fail('No text.');
+    require_once APP_ROOT . '/inc/android.php';
+    set_setting('ios_in_last', now_str());
+    $GLOBALS['rp_dup_win'] = 20; /* a Shortcut that runs twice within seconds: once only (a new "Cancel" later is handled again) */
+    $r = ad_incoming($from, mb_substr($text, 0, 1000));
+    json_out(['ok' => true, 'result' => (string)($r['result'] ?? $r['kind'] ?? 'kept')]);
+
+case 'hair_menu':
+    need_admin();
+    if ($method !== 'POST') fail('POST only', 405);
+    json_out(['ok' => true] + hair_menu_apply(!empty($in['replace']), (string)(hair_cfg()['kind'])));
+
+}
+fail('Unknown action', 404);
