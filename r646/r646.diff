+    $out = [];
+    foreach (['hair_get', 'hair_menu', 'ios_in'] as $act) {
+        $php = PHP_BINARY; $code = 'define("APP_ROOT", ' . var_export($root, true) . '); $_SERVER["REQUEST_METHOD"] = "GET"; $_SERVER["HTTP_HOST"] = "localhost"; $_GET["action"] = ' . var_export($act, true) . '; chdir(' . var_export($root, true) . '); require ' . var_export($root . '/api.php', true) . ';';
