 const TXL_MODEL = 'deepgram/nova-3';
 const TXL_GAP = 3;      // seconds between two readings of the same call (the words keep coming)
 const TXL_MAX_N = 60;   // readings per call at most (cost guard)
+/* (2.99.656 - real call #190 05/11 22:31: "make an appointment… for a manicure… I want to add another person for a pedicure" -> the AI said intent "add"
+   (add to an appointment they have) and the 2nd person was never booked on the call; after the call "Check booking". A call read while they talk / a call
+   booked on it is ONE booking: everything agreed in this call. */
+const TXL_AI_NOTE = "THIS CALL IS READ WHILE THEY TALK (or was booked while they talked): everything asked for in THIS call is ONE booking - intent \"book\" "
+    . "(never \"add\" or \"change\" for a person, service or time asked for earlier in this SAME call), people = everybody in it (the caller + every person added in this call), "
+    . "party = one entry per person (the caller first, with that person's services), date / time = the LAST day / time agreed. "
+    . "Only an appointment made BEFORE this call (another day / another call) keeps intent \"cancel\" / \"change\" / \"add\".\n";
+/** The call as the AI reads it after the call: with TXL_AI_NOTE when a booking was made on it (not decided yet). */
+function txl_ai_ctx(array $c): array { $sid = (string)($c['call_sid'] ?? ''); if ($sid !== '' && is_file(txl_file($sid, 'json'))) { $st = txl_state($sid); if (empty($st['done']) && !empty($st['ids'])) $c['ai_extra'] = TXL_AI_NOTE; } return $c; }
+/** (2.99.656) An "add" that still came for a booking made on this call, with everybody in the party = the whole booking. */
+function txl_add_whole(array $j): array {
+    if (strtolower(trim((string)($j['intent'] ?? ''))) !== 'add') return $j;
+    $party = array_values(array_filter((array)($j['party'] ?? []), 'is_array'));
+    if (count($party) >= 2 && count($party) >= (int)($j['people'] ?? 0)) { $j['intent'] = 'book'; $j['people'] = count($party); }
+    return $j;
+}
 
 function txl_on(): bool { return setting('tx_live') === '1'; }
 /** The TeXML before the iPhone's <Dial>: the words of both legs to ?a=tr. */
