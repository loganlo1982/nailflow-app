+    if ($n > CL_GROUP_MAX || ($n > 1 && !$b['ok'])) return null; /* (2.99.667) several people, not clear who gets what */
+    $cf = $j['confidence'] ?? null; $conf = is_numeric($cf) ? (float)$cf : 1.0; if ($conf > 1 && $conf <= 100) $conf /= 100;
