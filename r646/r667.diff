+<?php
+/* (2.99.667 – anh Logan 06/11: "Khi khách text vào số 1130 muốn book hẹn thì hiện thông báo cho App … Nếu khách nt book hẹn thì app tự động book hẹn nếu không bị
+   kẹt giờ, không có thợ. Còn không book được thì nt lại cho khách các lựa chọn khác về giờ hoặc ngày khác.")
+   💬 A CUSTOMER'S TEXT THAT ASKS FOR AN APPOINTMENT (after STOP / CONFIRM / cancel / the 666 "picks the offered time" – those are unchanged):
+   the SAME AI reading as a voicemail (cl_ai, its rules: the 664 "a service nobody said is never guessed", the 602 manicure / pedicure question) and the SAME checks
+   as the phone switchboard (cl_ivr_jppl, cl_ivr_fit: hours, not gone, enough techs, the tech named can do it + is free, cl_ivr_offer: the 2 nearest open times).
+     – all there + the time fits + the tech said (a name, or "anyone")  → booked like a call booking ("💬 Booked from a text"), ONE YOU'RE BOOKED text (or the 602 question),
+                                                                          owner push "💬 Booked by text: …"
+     – no tech said (2.99.665 rule)                                     → asked ONCE ("Any tech, or someone special?"); the answer books (a name → that tech, else Any tech)
+     – the time does not fit                                            → ONE text with the 2 nearest open times; the reply that picks one books it
+     – something missing (service / day / time / name)                  → ONE question; the next texts (≤ 2 hours) are read together with the first
+     – not a booking / not clear / AI fails / several people not clear  → as before (Messages + the normal push), nothing sent
+   Limits: at most ONE such text per number per 10 minutes, except the answers in the same conversation (≤ TB_CONV_MAX in 2 hours); never a STOP / wrong number;
+   texts only when Auto send is ready and its "Confirm" kind is on (else booked / nothing sent, the owner told). Every salon (its own name, techs, services, hours).
+   "Owner approves phone bookings" (call_approve, cl_pend_on) on → the text booking is kept with an amber "⏳ Chờ duyệt … (text booking)" note too (the texts go as usual). */
+declare(strict_types=1);
+if (!defined('APP_ROOT')) { http_response_code(404); exit; }
+
+const TB_CTX_H = 2;        /* (2.99.667) a question / offer of ours waits this many hours for the answer */
+const TB_GAP = 600;        /* (2.99.667) one automatic text per number per 10 minutes (a new request) */
+const TB_CONV_MAX = 3;     /* (2.99.667) texts of ours in one conversation (2 hours) at most */
+const TB_ASKS = 2;         /* (2.99.667) questions for what is missing, at most */
+const TB_DAY_MAX = 150;    /* (2.99.667) AI reads of texts per salon per day (cost cap) */
+const TB_PEND_NOTE = '⏳ Chờ duyệt · waiting for your OK (text booking)';
+const TB_BOOK_RE = '/\b(appointments?|appts?|apt|book|booking|schedule|scheduling|reserve|reservation|available|availability|openings?|open spots?|spots?|slots?|come in|coming in|get in|fit (me|us) in|squeeze (me|us) in|cita|citas|agendar|reservar|dat hen|lay hen)\b/i';
+const TB_ACK_RE = '/^(ok|okay|okey|k|kk|yes|yeah|yea|yep|yup|y|no|nope|nah|sure|thanks?|thank you|thank u|thx|ty|cool|great|perfect|awesome|nice|good|got it|sounds good|see you|see ya|bye|lol|haha|gracias|si|vale)( (thanks?|thank you|so much|you))*$/';
+
+/** (2.99.667) On for this salon: a nail salon (a hair salon texts by hand), not a demo, the booking code + an AI key there. */
+function tb_on(): bool {
+    if ((string)setting('tb_on') === '0' || is_demo_site() || (function_exists('is_hair') && is_hair()) || !function_exists('create_group')) return false;
+    require_once __DIR__ . '/calls-job.php';
+    return cl_ai_ready();
+}
+function tb_norm(string $t): string { return trim((string)preg_replace('/\s+/', ' ', (string)preg_replace('/[^a-z0-9 ]+/', ' ', strtolower(function_exists('nf_no_accents') ? nf_no_accents($t) : $t)))); }
+/** (2.99.667) "ok" / "thanks" / "yes" alone – never a booking. */
+function tb_is_ack(string $t): bool { $n = tb_norm($t); return $n === '' || (bool)preg_match(TB_ACK_RE, $n); }
+/** (2.99.667) the cheap check before the AI: booking words, or a day / time AND a service word. */
+function tb_looks(string $t): bool {
+    if (tb_is_ack($t)) return false;
+    $n = ' ' . tb_norm($t) . ' ';
+    if (preg_match(TB_BOOK_RE, $n)) return true;
+    return cl_ivr_has_when($n) && (bool)preg_match(CL_SVC_WORDS, ' ' . cl_norm($t) . ' ');
+}
+/* (2.99.667) ---------- the conversation (one per number, 2 hours) ---------- */
+function tb_states(): array { $l = json_decode((string)setting('tb_conv'), true); return is_array($l) ? $l : []; }
+function tb_state(string $p): ?array { $s = tb_states()[$p] ?? null; return is_array($s) && (int)($s['at'] ?? 0) > time() - TB_CTX_H * 3600 ? $s : null; }
+function tb_state_set(string $p, ?array $s): void {
+    $l = array_filter(tb_states(), fn($x) => is_array($x) && (int)($x['at'] ?? 0) > time() - TB_CTX_H * 3600);
+    if ($s === null) unset($l[$p]); else $l[$p] = $s + ['at' => time()];
+    set_setting('tb_conv', json_encode((object)$l, JSON_UNESCAPED_UNICODE));
+}
+/** (2.99.667) the salon's last text to this number is our question / offer (nothing newer from the salon): the answer is ours (rt_try leaves it). */
+function tb_owns_last(string $p): bool {
+    $s = tb_state($p); if (!$s || (string)($s['body'] ?? '') === '') return false;
+    if (!function_exists('rt_last_out')) require_once __DIR__ . '/replytime.php';
+    $l = rt_last_out($p); return $l !== null && trim($l[1]) === trim((string)$s['body']);
+}
+/** (2.99.667) may we text now? A new request: none of ours in 10 minutes; an answer in our conversation: ≤ TB_CONV_MAX in 2 hours. */
+function tb_rate_ok(string $p, bool $conv): bool {
+    $l = json_decode((string)setting('tb_sent'), true); $t = array_filter((array)(is_array($l) ? ($l[$p] ?? []) : []), fn($x) => (int)$x > time() - TB_CTX_H * 3600);
+    if (!$conv) return !array_filter($t, fn($x) => (int)$x > time() - TB_GAP);
+    return count($t) < TB_CONV_MAX;
+}
+function tb_rate_mark(string $p): void {
+    $l = json_decode((string)setting('tb_sent'), true); $l = is_array($l) ? $l : [];
+    foreach ($l as $k => $ts) { $l[$k] = array_values(array_filter((array)$ts, fn($x) => (int)$x > time() - TB_CTX_H * 3600)); if (!$l[$k]) unset($l[$k]); }
+    $l[$p] = array_merge($l[$p] ?? [], [time()]); set_setting('tb_sent', json_encode((object)$l));
+}
+/** (2.99.667) Auto send ready + its "Confirm" kind on (the owner's switch for booking texts). */
+function tb_can_text(): bool { if (!function_exists('as_kind_on')) require_once __DIR__ . '/autosend.php'; return as_ready() && as_kind_on('confirm'); }
+/** (2.99.667) ONE text of ours (in the Messages conversation too). '' = sent; else why not. */
+function tb_send(string $p, string $body, bool $conv, string $info): string {
+    if (!tb_can_text()) return 'auto send / Confirm texts are off';
+    if (!tb_rate_ok($p, $conv)) return 'already texted them a moment ago';
+    require_once __DIR__ . '/sms-short.php'; if (sms_short_on()) $body = gsm7_clean($body);
+    q('INSERT INTO messages (phone, dir, body, is_read, created_at) VALUES (?, ?, ?, 1, ?)', [$p, 'out', $body, now_str()]); $om = (int)db()->lastInsertId();
+    $c = customer_by_phone($p); $nm = trim((string)($c['name'] ?? ''));
+    $aid = as_add('reply', 'ui:tbk:' . $om, $p, $nm !== '' ? $nm : pretty_phone($p), $body, $info);
+    if (!$aid) { q('DELETE FROM messages WHERE id = ?', [$om]); return 'this number may not be texted'; }
+    tb_rate_mark($p); as_flush(false, [$aid]);
+    return '';
+}
+function tb_salon(): string { return trim((string)setting('salon_name')) ?: 'Our salon'; }
+function tb_link(): string { $l = pub_url() . '/'; if (function_exists('short_url')) { try { $s = short_url($l); if (is_string($s) && $s !== '') $l = $s; } catch (Throwable $e) {} } return $l; }
+function tb_when(string $d, int $m): string { return date('D n/j', strtotime($d)) . ' ' . min_to_label($m); }
+/** (2.99.667) the owner's ONE notification for this text (instead of the plain "new text" one). */
+function tb_push(string $p, string $title, string $line, int $apptId, string $date, int $mid): void {
+    try { notify_admin('message', $title . ': ' . $line, $apptId, ['title' => $title, 'body' => $line, 'url' => $apptId ? '?appt=' . $apptId . '&date=' . $date : '?tab=messages&mid=' . $mid, 'tag' => 'msg-' . preg_replace('/\D/', '', $p), 'thread' => 'msg-' . preg_replace('/\D/', '', $p)]); }
+    catch (Throwable $e) { error_log('667 push: ' . $e->getMessage()); }
+}
+function tb_who(string $p, string $name): string { return $name !== '' ? cl_name($name) : pretty_phone($p); }
+
+/** (2.99.667) The customer's text → booked / offered / asked: ['result' => …, 'apptId' => …] – or null (not ours: Messages + the normal push as before). */
+function tb_try(string $phone, string $text, int $mid): ?array {
+    $p = norm_phone($phone); if (strlen($p) !== 12 || trim($text) === '') return null;
+    $st = tb_state($p); $own = $st !== null && tb_owns_last($p); if (!$own) $st = null;
+    if (!$st && tb_is_ack($text)) return null;
+    if ($st && ($st['kind'] ?? '') !== 'tech' && tb_is_ack($text)) return null;
+    if (!tb_on()) return null;
+    if (!function_exists('ad_stopped')) require_once __DIR__ . '/stophook.php';
+    if (!function_exists('out_not_stopped')) require_once __DIR__ . '/outbox.php';
+    if (!function_exists('as_add')) require_once __DIR__ . '/autosend.php';
+    if (ad_stopped($p) || !out_not_stopped($p) || cust_wrong($p) || no_text_phone($p)) return null; /* (2.99.667) never a STOP / wrong number / the salon's own line */
+    if (!$st && !tb_looks($text)) return null;
+    require_once __DIR__ . '/replies.php';
+    if (!$st && rp_upcoming($p) && preg_match("/\b(re-?schedul\w*|resched\w*|change|changing|move|moving|switch|later|earlier|instead|postpone|push (it )?back|another (time|day|date)|different (time|day|date)|new time|cambiar)\b/iu", $text)) return null; /* (2.99.667) moving the one they have: the existing flows */
+    $words = $text; $prevAt = time();
+    if ($st) { $prevAt = (int)($st['t0'] ?? $st['at']);
+        $in = q("SELECT body FROM messages WHERE phone = ? AND dir = 'in' AND created_at >= ? ORDER BY id DESC LIMIT 4", [$p, date('Y-m-d H:i:s', $prevAt - 5)])->fetchAll(PDO::FETCH_COLUMN);
+        if ($in) $words = implode("\n", array_reverse(array_map('strval', $in))); }
+    $c = ['id' => 0, 'kind' => 'vm', 'from_phone' => $p, 'text_c' => $words, 'text_s' => '', 'ai_json' => '', 'call_sid' => ''];
+    if ($st && ($st['kind'] ?? '') === 'offer' && ($r = tb_pick($p, $text, $st, $c, $mid))) return $r;
+    if ($st && ($st['kind'] ?? '') === 'tech') { $j = (array)$st['j']; $t = cl_talk_techs($text); $j['tech_id'] = $t[0] ?? 0; $j['tech_text'] = ''; $j['tech_last'] = false;
+        return tb_eval($p, $j, $c, $st + ['techq' => 1], $mid, $text); }
+    $n = json_decode((string)setting('tb_ai_n'), true); $d = date('Y-m-d'); if (!is_array($n) || ($n['d'] ?? '') !== $d) $n = ['d' => $d, 'n' => 0];
+    if ((int)$n['n'] >= TB_DAY_MAX) return null; $n['n'] = (int)$n['n'] + 1; set_setting('tb_ai_n', json_encode($n));
+    $c['ai_extra'] = "NOTE: this is NOT a phone call. The words above are the customer's TEXT MESSAGES (SMS) to the salon, oldest first (several texts = one request; a later text adds to or corrects an earlier one). Read them like a voicemail.\n";
+    try { $j = cl_weekday_fix($c, cl_ai_after($c, cl_ai($c))); } catch (Throwable $e) { error_log('667 text AI: ' . $e->getMessage()); return null; }
+    if (strtolower(trim((string)($j['intent'] ?? ''))) !== 'book') return null;
+    return tb_eval($p, $j, $c, ($st ?? []) + ['t0' => $prevAt], $mid, $text);
+}
+/** (2.99.667) The booking as read → booked / offered / asked / null. $st = the conversation so far (asks, techq). */
+function tb_eval(string $p, array $j, array $c, array $st, int $mid, string $text): ?array {
+    $conv = !empty($st['kind']);
+    $file = customer_by_phone($p);
+    $name = mb_strtoupper(trim(mb_substr((string)preg_replace('/\s+/u', ' ', (string)($j['customer_name'] ?? '')), 0, 55)));
+    if ($name === '' && $file && trim((string)$file['name']) !== '') $name = mb_strtoupper(trim((string)$file['name']));
+    if (!empty($j['tech_last'])) { /* (2.99.667) "the same tech as last time" = the tech of their last visit (as a call), none → not sure */
+        $lt = (int)q("SELECT staff_id FROM appointments WHERE phone = ? AND kind = 'appt' AND status IN ('arrived', 'paid') AND staff_id > 0 ORDER BY appt_date DESC, start_min DESC LIMIT 1", [$p])->fetchColumn();
+        if (!$lt || !q('SELECT 1 FROM staff WHERE id = ? AND active = 1', [$lt])->fetchColumn()) return null; $j['tech_id'] = $lt; $j['tech_text'] = ''; }
