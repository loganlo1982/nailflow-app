+    $date = valid_date((string)($j['date'] ?? '')) ? (string)$j['date'] : '';
+    $start = preg_match('/^(\d{1,2}):(\d{2})$/', (string)($j['time'] ?? ''), $m) && (int)$m[1] < 24 && (int)$m[2] < 60 ? (int)$m[1] * 60 + (int)$m[2] : -1;
+    if ($date !== '' && $date > date('Y-m-d', strtotime('+90 days'))) return null;
